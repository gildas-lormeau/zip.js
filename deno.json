{
	"name": "@zip-js/zip-js",
	"version": "2.8.61",
	"exports": {
		".": "./index.js",
		"./external": "./lib/zip-fs-external.js",
		"./mime-types": "./lib/zip-mime-types.js",
		"./lib/zip-core-external.js": "./lib/zip-core-external.js",
		"./lib/zip-fs-core-external.js": "./lib/zip-fs-core-external.js",
		"./lib/zip-core-custom.js": "./lib/zip-core-custom.js",
		"./worker": "./lib/core/web-worker-base.js",
		"./lib/core/web-worker-base.js": "./lib/core/web-worker-base.js"
	},
	"publish": {
		"exclude": [
			"tests/",
			"dist/",
			"!dist/zip-web-worker.js",
			"!dist/zip-module.wasm",
			"*.cjs",
			"index.d.cts",
			"index.min.js",
			"index-native.js",
			"index-native.min.js",
			"package.json",
			"package-lock.json",
			".npmignore",
			"eslint.config.mjs",
			"worker-message-property-names.js",
			"lib/core/web-worker-inline-template.js",
			"lib/core/web-worker-inline-template-native.js",
			"lib/core/zlib-streams-inline-template.js",
			"lib/core/web-worker-inline-base.js"
		]
	},
	"lint": {
		"exclude": [
			"dist/*.js",
			"*-inline.js",
			"lib/core/web-worker-inline-wasm.js",
			"lib/core/web-worker-inline-native.js",
			"lib/core/zlib-streams-inline.js",
			"tests/",
			"benchmarks/",
			"**/*.cjs",
			"**/*.min.js"
		]
	},
	"exclude": [
		"rollup*",
		"reserved-property-names.js",
		"mangled-property-names.js",
		"mime-types.json",
		"generate-mime-type-data.js",
		"sync-versions.js",
		"tsconfig.json",
		".vscode",
		".eslintrc.json",
		"benchmarks",
		"docs",
		".github",
		"tests/corpus",
		"tests/fidelity/corpus"
	]
}